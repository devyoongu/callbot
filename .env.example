# ──────────────────────────────────────────────────────────────────────
# callbot/.env.example — 이 파일을 .env 로 복사 후 값을 채워주세요
# ──────────────────────────────────────────────────────────────────────

# SIP 등록 설정 (Asterisk 서버 접속 정보)
SIP_SERVER=172.31.79.202
SIP_PORT=5060
SIP_USERNAME=2001
SIP_PASSWORD=secret2001
# LOCAL_IP: 비워두면 자동 감지. NAT 환경에서 문제가 생기면 직접 지정
LOCAL_IP=
# SIP_LOCAL_PORT: 봇이 로컬에서 바인드할 SIP UDP 포트 (기본 5080)
# NAT 환경에서 5060을 쓰면 응답 패킷이 돌아오지 않는 경우가 있으므로
# 5060이 아닌 다른 포트(5080 등)를 사용하는 것을 권장합니다.
SIP_LOCAL_PORT=5080

# Google Cloud
GCP_PROJECT_ID=gen-lang-client-0665942228
# STT 모델: telephony (전화 품질, 권장) / chirp_3 (범용 고품질)
GCP_STT_MODEL=telephony
GCP_STT_LANGUAGE=ko-KR
# TTS 음성: chirp3-hd-achernar (여성, 권장) / chirp3-hd-achird (남성)
GCP_TTS_VOICE=chirp3-hd-achernar
# CREDENTIALS_DIR: 비워두면 callbot/crendential/ 자동 사용
CREDENTIALS_DIR=

# Athena LLM (비워두면 fallback 메시지로만 응답)
ATHENA_SITE=
ATHENA_AUTH=
ATHENA_USER_ID=
ATHENA_CHAT_ROOMS_ID=
ATHENA_SCENARIOS_ID=

# 대화 동작 튜닝
LISTEN_TIMEOUT_SEC=15
MAX_NO_INPUT=3
FALLBACK_GREETING=안녕하세요. 무엇을 도와드릴까요?
FALLBACK_NO_INPUT=잘 들리지 않습니다. 다시 말씀해 주세요.
FALLBACK_GOODBYE=감사합니다. 안녕히 계세요.
